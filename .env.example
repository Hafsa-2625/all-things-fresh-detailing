# Copy to .env.local (never commit real values).
# NEXT_PUBLIC_* values are embedded at build time: set them before `npm run build`.

# --- Site -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://www.allthingsfreshcardetailing.com
NEXT_PUBLIC_TENANT_ID=all-things-fresh

# --- Supabase ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser or prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# The only address that can become the first super admin (while no active super admin exists).
ADMIN_BOOTSTRAP_EMAIL=

# --- Email (Resend) -----------------------------------------------------------
EMAIL_PROVIDER=resend
EMAIL_PROVIDER_KEY=
# Must be an address on a domain verified in Resend (onboarding@resend.dev only reaches the account owner).
EMAIL_FROM=no-reply@allthingsfreshcardetailing.com
# Comma-separated fallback recipients for new-lead emails; admins add more under Leads → New-lead emails.
LEAD_NOTIFICATION_EMAIL=

# --- Notifications / booking relay (optional) --------------------------------
LEAD_NOTIFICATION_WEBHOOK_URL=
LEAD_NOTIFICATION_WEBHOOK_SECRET=
BOOKING_WEBHOOK_SIGNING_SECRET=

# --- Development only ---------------------------------------------------------
# Without Supabase, development stores records in .data/atf-local-store.json.
# Production refuses filesystem storage unless this is explicitly "true".
ATF_ALLOW_LOCAL_STORE=
ATF_LOCAL_DB_PATH=
